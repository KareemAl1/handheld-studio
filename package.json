{
  "name": "handheld-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:start": "node scripts/local-preview.mjs start",
    "preview:status": "node scripts/local-preview.mjs status",
    "preview:stop": "node scripts/local-preview.mjs stop",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "node scripts/verify-milestone3.mjs",
    "test:production:milestone2": "node scripts/verify_production.mjs",
    "test:performance": "node scripts/profile-studio.mjs",
    "test:performance:game": "node scripts/profile-game.mjs",
    "asset:build": "python scripts/run_blender.py build",
    "asset:export": "python scripts/run_blender.py export"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
